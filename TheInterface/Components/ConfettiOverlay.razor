@if (Visible)
{
    <div class="confetti-overlay">
        @for (int i = 0; i < 60; i++)
        {
            <div class="confetti-piece" style="
                left: @(Random.Shared.Next(0, 100))vw;
                animation-delay: @(Random.Shared.NextDouble() * 2)s;
                background-color: @(_colors[Random.Shared.Next(_colors.Length)]);
                width: @(Random.Shared.Next(8, 16))px;
                height: @(Random.Shared.Next(8, 16))px;
                transform: rotate(@(Random.Shared.Next(0, 360))deg);
            "></div>
        }
    </div>
}

<style>
    .confetti-overlay {
        position: fixed;
        top: 0; left: 0;
        width: 100vw; height: 100vh;
        pointer-events: none;
        z-index: 9999;
        overflow: hidden;
    }

    .confetti-piece {
        position: absolute;
        top: -20px;
        border-radius: 2px;
        animation: fall 3s ease-in forwards;
    }

    @@keyframes fall {
        0%   { transform: translateY(0) rotate(0deg); opacity: 1; }
        100% { transform: translateY(110vh) rotate(720deg); opacity: 0; }
    }
</style>

@code {
    [Parameter] public bool Visible { get; set; }

    private readonly string[] _colors =
    [
        "#ff6b6b", "#ffd93d", "#6bcb77", "#4d96ff",
        "#ff922b", "#cc5de8", "#f06595", "#74c0fc"
    ];
}