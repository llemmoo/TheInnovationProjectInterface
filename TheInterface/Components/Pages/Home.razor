@page "/"
@using TheInterface.Components.Dialogs
@using TheInterface.Core
@using TheInterface.Model
@using TheInterface.Repository
@inject MicroBitReader MicroBitReader
@inject IDialogService DialogService
@inject IJSRuntime JsRuntime
@implements IDisposable

<PageTitle>DATA ROBOTTEN</PageTitle>

<MudGrid Style="margin-top: 3vh;">
    <MudItem xs="8">
        <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge">
            <MudPaper Class="d-flex align-center justify-center mud-width-full py-8">
                <MudGrid Class="mt-4">
                    <MudItem xs=12 Style="justify-self:center; align-self: center; margin: 0.5vw">
                        <MudCard Style="align-items: flex-end;">
                            <MudStack Row="true">
                                <MudText Typo="Typo.h1">🤖</MudText>
                                <div style="position: relative; margin-top: 8px;">
                                    <div style="
                                    position: absolute;
                                    left: -10px;
                                    top: 16px;
                                    width: 0;
                                    height: 0;
                                    border-top: 8px solid transparent;
                                    border-bottom: 8px solid transparent;
                                    border-right: 10px solid #e0e0e0;
                                "></div>
                                    <MudPaper Elevation="2"
                                              Style="@($"background-color: {_bubbleColor}; color: {_bubbleTextColor}; border-radius: 18px; padding: 12px 18px; max-width: 280px; font-size: 1.25rem; line-height: 1.5; transition: background-color 0.4s ease, color 0.4s ease;")">
                                        @_dataBotText
                                    </MudPaper>
                                </div>
                            </MudStack>
                        </MudCard>
                    </MudItem>
                    @foreach (var dream in _dreams)
                    {
                        var isViable = _candidates.Contains(dream);
                        <MudItem xs="3" Style="margin: 0">
                            <MudCard
                                Style="@(isViable ? "" : "opacity: 0.4; filter: grayscale(100%); transition: all 0.3s ease;")">
                                <MudCardMedia Style="@($"background-color: {dream.Color}; height: 150px;")"/>
                                <MudCardContent>
                                    <MudText>@dream.Name</MudText>
                                    @if (!isViable)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Close" Color="Color.Error"/>
                                    }
                                    else
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success"/>
                                    }
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    }
                </MudGrid>
            </MudPaper>
        </MudContainer>
    </MudItem>

    <MudItem xs="3">
        <MudPaper Class="d-flex align-center justify-center mud-width-full mx-8" Elevation="4">
            <MudStack Style="width:100%; padding:16px;">
                <MudText Typo="Typo.button" Style="align-self: center; font-size: large;">DRØMMEDATA</MudText>
                <MudStack Row="true">
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" FullWidth="true"
                               OnClick="ResetAll">
                        Nulstil målinger
                    </MudButton>
                    <MudToggleIconButton 
                        ToggledChanged="b => _debugOpen = b" 
                        Variant="Variant.Filled" 
                        Color="Color.Default" 
                        ToggledColor="Color.Dark" 
                        Icon="@Icons.Material.Filled.BugReport" 
                        Toggled="@_debugOpen" />
                </MudStack>
                @if (_lockedSound.HasValue)
                {
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudChip T="string" Color="Color.Primary" Size="Size.Large">
                            🔊 Målt: @(_lockedSound.Value.ToString("F2"))
                        </MudChip>
                        <MudButton Variant="Variant.Filled" Size="Size.Small" OnClick="@(() => Reset(Sensor.Sound))">
                            Nulstil
                        </MudButton>
                    </MudStack>
                }
                @if (_lockedLight.HasValue)
                {
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudChip T="string" Color="Color.Warning" Size="Size.Large">
                            💡 Målt: @(_lockedLight.Value.ToString("F2"))
                        </MudChip>
                        <MudButton Variant="Variant.Filled" Size="Size.Small" OnClick="@(() => Reset(Sensor.Light))">
                            Nulstil
                        </MudButton>
                    </MudStack>
                }
                @if (_lockedTemp.HasValue)
                {
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudChip T="string" Color="Color.Error" Size="Size.Large">
                            🌡️ Målt: @(_lockedTemp.Value.ToString("F2"))
                        </MudChip>
                        <MudButton Variant="Variant.Filled" Size="Size.Small"
                                   OnClick="@(() => Reset(Sensor.Temperature))">Nulstil
                        </MudButton>
                    </MudStack>
                }
                @if (_lockedShake.HasValue)
                {
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudChip T="string" Color="Color.Success" Size="Size.Large">
                            🫨 Målt: @(_lockedShake.Value.ToString("F2"))
                        </MudChip>
                        <MudButton Variant="Variant.Filled" Size="Size.Small" OnClick="@(() => Reset(Sensor.Shake))">
                            Nulstil
                        </MudButton>
                    </MudStack>
                }

                @switch (MicroBitReader.SelectedSensor)
                {
                    case Sensor.Sound:
                        <MudStack>
                            <MudText Typo="Typo.button">
                                Lyd @(_isMeasuringSound ? " — måler..." : "")
                            </MudText>
                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                <MudIcon Size="Size.Large" Icon="@Icons.Material.Filled.VolumeOff"/>
                                <MudSlider
                                    Value="@(_isMeasuringSound ? MicroBitReader.SoundLevel : (_lockedSound ?? MicroBitReader.SoundLevel))"
                                    Min="0.0" Max="1.0" Step="0.01" Disabled="true"
                                    Size="Size.Large"
                                    Color="Color.Primary" Style="flex:1;"/>
                                <MudIcon Size="Size.Large" Icon="@Icons.Material.Filled.VolumeUp"/>
                            </MudStack>
                        </MudStack>
                        break;

                    case Sensor.Light:
                        <MudStack>
                            <MudText Typo="Typo.button">
                                Lys @(_isMeasuringLight ? " — måler..." : "")
                            </MudText>
                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                <MudIcon Size="Size.Large" Icon="@Icons.Material.Filled.DarkMode"/>
                                <MudSlider
                                    Value="@(_isMeasuringLight ? MicroBitReader.LightLevel : (_lockedLight ?? MicroBitReader.LightLevel))"
                                    Min="0.0" Max="1.0" Step="0.01" Disabled="true"
                                    Size="Size.Large"
                                    Color="Color.Warning" Style="flex:1;"/>
                                <MudIcon Size="Size.Large" Icon="@Icons.Material.Filled.LightMode"/>
                            </MudStack>
                        </MudStack>
                        break;

                    case Sensor.Temperature:
                        <MudStack>
                            <MudText Typo="Typo.button">
                                Temperatur @(_isMeasuringTemp ? " — måler..." : "")
                            </MudText>
                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                <MudIcon Size="Size.Large" Icon="@Icons.Material.Filled.AcUnit"/>
                                <MudSlider
                                    Value="@(_isMeasuringTemp ? MicroBitReader.TemperatureLevel : (_lockedTemp ?? MicroBitReader.TemperatureLevel))"
                                    Min="0.0" Max="1.0" Step="0.01" Disabled="true"
                                    Size="Size.Large"
                                    Color="Color.Error" Style="flex:1;"/>
                                <MudIcon Size="Size.Large" Icon="@Icons.Material.Filled.Whatshot"/>
                            </MudStack>
                        </MudStack>
                        break;

                    case Sensor.Shake:
                        <MudStack>
                            <MudText Typo="Typo.button">
                                Bevægelse @(_isMeasuringShake ? " — måler..." : "")
                            </MudText>
                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                <MudIcon Size="Size.Large" Icon="@Icons.Material.Filled.SelfImprovement"/>
                                <MudSlider
                                    Value="@(_isMeasuringShake ? MicroBitReader.ShakeLevel : (_lockedShake ?? MicroBitReader.ShakeLevel))"
                                    Min="0.0" Max="1.0" Step="0.01" Disabled="true"
                                    Size="Size.Large"
                                    Color="Color.Success" Style="flex:1;"/>
                                <MudIcon Size="Size.Large" Icon="@Icons.Material.Filled.DirectionsRun"/>
                            </MudStack>
                        </MudStack>
                        break;
                }
                @if (_debugOpen)
                {
                    <MudSelect T="Dream" ValueChanged="dream => _debugDream = dream!">
                        @foreach (var dream in _dreams)
                        {
                            <MudSelectItem T="Dream" Value="dream">@dream.Name</MudSelectItem>
                        }
                    </MudSelect>
                    <MudButton Variant="Variant.Filled" Color="Color.Tertiary"
                               OnClick="@(() => _confirmedDream = _debugDream!)">
                        TEST
                    </MudButton>
                }
            </MudStack>
        </MudPaper>
    </MudItem>
</MudGrid>

<audio id="possiblyCorrect" src="./sounds/possiblyCorrect.wav"></audio>
<audio id="tada" src="./sounds/tada.wav"></audio>
<audio id="notificationSound" src="./sounds/notification.wav"></audio>

<ConfettiOverlay Visible="_showConfetti"/>

@if (_confirmedDream is not null)
{
    <MudOverlay Visible="@(_confirmedDream is not null)" DarkBackground="true">
        <MudStack AlignItems="AlignItems.Center">
            @if (_showInformationBlocks)
            {
                <MudPaper
                    Style="@($"background-color: {_confirmedDream.Color}; width: 1000px; height: 600px; align-items: center; justify-content: space-evenly;")"
                    Elevation="2"
                >
                    <MudGrid Spacing="3" Class="pa-3">
                        @foreach (var (informationBlock, index) in _confirmedDream!.InformationBlocks!.Select((b, i) => (b, i)))
                        {
                            <MudItem xs="12" sm="6">
                                <MudCard Elevation="2" Class="h-100" Style="background-color: rgba(255,255,255,0.9)">
                                    <MudCardHeader>
                                        <CardHeaderContent>
                                            <MudText Typo="Typo.h6" Color="Color.Primary">
                                                Information @informationBlock.BlockNumber
                                            </MudText>
                                        </CardHeaderContent>
                                    </MudCardHeader>
                                    <MudCardContent>
                                        <MudStack Spacing="2">
                                            <div>
                                                <MudText Typo="Typo.body1"><i>@informationBlock.BlockInformation</i></MudText>
                                            </div>
                                            <MudDivider/>
                                            <div>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">Ledetråd</MudText>
                                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                                    <MudText Typo="Typo.body2">
                                                        @if (!_hiddenHintBlocks.Contains(index))
                                                        {
                                                            <i><b>@informationBlock.BlockInformationHighlight</b></i>
                                                        }
                                                        else
                                                        {
                                                            <i><b>••••••</b></i>
                                                        }
                                                    </MudText>
                                                    <MudToggleIconButton
                                                        Toggled="@_hiddenHintBlocks.Contains(index)"
                                                        ToggledChanged="b => { if (b) _hiddenHintBlocks.Add(index); else _hiddenHintBlocks.Remove(index); }"
                                                        Icon="@Icons.Material.Filled.Visibility"
                                                        ToggledIcon="@Icons.Material.Filled.VisibilityOff"
                                                        Color="Color.Default"
                                                        ToggledColor="Color.Default"
                                                        Size="Size.Small" />
                                                </MudStack>
                                            </div>
                                            <MudDivider/>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="justify-self: flex-start">
                                                Sensor
                                            </MudText>
                                            <MudStack Row="true" Justify="Justify.SpaceBetween"
                                                      AlignItems="AlignItems.Center">
                                                <div>
                                                    <MudText Typo="Typo.body2">
                                                        @if (!_hiddenSensorBlocks.Contains(index))
                                                        {
                                                            @switch (informationBlock.Sensor)
                                                            {
                                                                case Sensor.Sound:
                                                                    @:Lyd
                                                                    break;
                                                                case Sensor.Temperature:
                                                                    @:Temperatur
                                                                    break;
                                                                case Sensor.Shake:
                                                                    @:Bevægelse
                                                                    break;
                                                                case Sensor.Light:
                                                                    @:Lys
                                                                    break;
                                                                default:
                                                                    @:@informationBlock.Sensor
                                                                    break;
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <i><b>••••••</b></i>
                                                        }
                                                    </MudText>
                                                </div>
                                                <div style="display: flex;">
                                                @if (!_hiddenSensorBlocks.Contains(index))
                                                {
                                                    @switch (informationBlock.SensorReadingValue)
                                                    {
                                                        case SensorReadingValue.High:
                                                            <MudChip T="string" Color="Color.Error" Size="Size.Small"
                                                                     Variant="Variant.Filled">
                                                                Høj
                                                            </MudChip>
                                                            break;
                                                        case SensorReadingValue.Low:
                                                            <MudChip T="string" Color="Color.Tertiary" Size="Size.Small"
                                                                     Variant="Variant.Filled">
                                                                Lav
                                                            </MudChip>
                                                            break;
                                                        default:
                                                            @:@informationBlock.SensorReadingValue
                                                            break;
                                                    }
                                                }
                                                else
                                                {
                                                    <MudChip T="string" Color="Color.Dark" Size="Size.Small"
                                                             Variant="Variant.Filled">
                                                        ???
                                                    </MudChip>
                                                }
                                                <MudToggleIconButton
                                                        Toggled="@_hiddenSensorBlocks.Contains(index)"
                                                        ToggledChanged="b => { if (b) _hiddenSensorBlocks.Add(index);else _hiddenSensorBlocks.Remove(index); }"
                                                        Icon="@Icons.Material.Filled.Visibility"
                                                        ToggledIcon="@Icons.Material.Filled.VisibilityOff"
                                                        Color="Color.Default"
                                                        ToggledColor="Color.Default"
                                                        Size="Size.Small"/>
                                                </div>
                                            </MudStack>
                                        </MudStack>
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>
                        }
                    </MudGrid>
                </MudPaper>
                <MudButton Variant="Variant.Filled" Color="Color.Info"
                           OnClick="() => _showInformationBlocks = !_showInformationBlocks"
                           EndIcon="@Icons.Material.Filled.SwitchAccessShortcut">Se drømmefarven igen!
                </MudButton>
            }
            else
            {
                <MudPaper
                    Style="@($"background-color: {_confirmedDream.Color}; width: 1000px; height: 600px; display: flex; align-items: center; justify-content: center;")"
                    Elevation="1">
                    <MudPaper Style="background-color: rgba(0,0,0,0.2); backdrop-filter: blur(4px);"
                              Width="500px" Height="300px" Elevation="2"
                              Class="d-flex flex-column align-center justify-center">
                        <MudText Typo="Typo.h3" Style="color:white;">@_confirmedDream.Name</MudText>
                    </MudPaper>
                </MudPaper>
                <MudText Typo="Typo.h4" Style="color:white;">Sådan! Vi fandt Hito!</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Info"
                           OnClick="() => _showInformationBlocks = !_showInformationBlocks"
                           EndIcon="@Icons.Material.Filled.SwitchAccessShortcut">Se hvordan Data Robotten tolker
                    informationsblokkene!
                </MudButton>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ResetAll"
                       EndIcon="@Icons.Material.Filled.Replay"> Prøv igen!
            </MudButton>
        </MudStack>
    </MudOverlay>
}

@* ReSharper disable once NotAccessedField.Compiler *@

@code {
    private bool _isMeasuringSound, _isMeasuringLight, _isMeasuringTemp, _isMeasuringShake;
    private bool _dialogOpen;
    private float? _lockedSound, _lockedLight, _lockedTemp, _lockedShake;
    private CancellationTokenSource? _botResetCts;
    private string? _dataBotText;
    private DreamGuesser? _dreamGuesser;
    private DreamRepository? _dreamRepository;
    private List<Dream> _candidates = [];
    private List<Dream> _dreams = [];
    private bool _showGuessDialog;
    private Dream? _confirmedDream;
    private bool _showConfetti;
    private bool _showInformationBlocks;
    private string _bubbleColor = "#e0e0e0";
    private string _bubbleTextColor = "#212121";
    private bool _debugOpen;
    private Dream? _debugDream;
    private HashSet<int> _hiddenHintBlocks = [0,1,2,3];
    private HashSet<int> _hiddenSensorBlocks = [0,1,2,3];

        

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await DialogService.ShowAsync<IntroDialog>("", new DialogOptions
            {
                MaxWidth = MaxWidth.Small,
                FullWidth = true,
                CloseOnEscapeKey = false,
                BackdropClick = false
            });
        }
    }

    protected override void OnInitialized()
    {
        _dreamRepository = new DreamRepository();
        _dreams = _dreamRepository.GetDreams();
        _candidates = _dreams;
        _dreamGuesser = new DreamGuesser(_candidates);

        MicroBitReader.OnSoundLevelChanged += Update;
        MicroBitReader.OnLightLevelChanged += Update;
        MicroBitReader.OnTemperatureLevelChanged += Update;
        MicroBitReader.OnShakeLevelChanged += Update;
        MicroBitReader.OnSelectedSensorChanged += Update;
        MicroBitReader.OnMeasureChanged += OnMeasureChanged;

        _dataBotText = "Jeg venter på din næste måling!";
    }

    private void OnMeasureChanged()
    {
        if (!MicroBitReader.Measure) return;

        var alreadyMeasuring = MicroBitReader.SelectedSensor switch
        {
            Sensor.Sound => _isMeasuringSound,
            Sensor.Light => _isMeasuringLight,
            Sensor.Temperature => _isMeasuringTemp,
            Sensor.Shake => _isMeasuringShake,
            _ => false
        };

        if (alreadyMeasuring) return;

        var sensorKey = MicroBitReader.SelectedSensor switch
        {
            Sensor.Sound => "sound",
            Sensor.Light => "light",
            Sensor.Temperature => "temp",
            Sensor.Shake => "shake",
            _ => null
        };

        if (sensorKey is null) return;

        // Fire-and-forget onto the UI thread
        InvokeAsync(() => Measure(sensorKey));
    }

    private void ResetAll()
    {
        _lockedSound = _lockedLight = _lockedTemp = _lockedShake = null;
        _isMeasuringSound = _isMeasuringLight = _isMeasuringTemp = _isMeasuringShake = false;
        _candidates = _dreams;
        _confirmedDream = null;
        _showGuessDialog = false;
        _hiddenHintBlocks = [0, 1, 2, 3];
        _hiddenSensorBlocks = [0, 1, 2, 3];
        _showInformationBlocks = false;
    }

    private async Task Reset(Sensor sensorToReset)
    {
        switch (sensorToReset)
        {
            case Sensor.Sound:
                _lockedSound = null;
                break;
            case Sensor.Light:
                _lockedLight = null;
                break;
            case Sensor.Temperature:
                _lockedTemp = null;
                break;
            case Sensor.Shake:
                _lockedShake = null;
                break;
        }

        await Evaluate();
    }

    private async Task ConfirmGuess()
    {
        _confirmedDream = _candidates[0];
        _showGuessDialog = false;
        await TriggerTada();
        _showConfetti = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(3500);
        _showConfetti = false;
        await InvokeAsync(StateHasChanged);
    }

    private void Update() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        MicroBitReader.OnSoundLevelChanged -= Update;
        MicroBitReader.OnLightLevelChanged -= Update;
        MicroBitReader.OnTemperatureLevelChanged -= Update;
        MicroBitReader.OnShakeLevelChanged -= Update;
        MicroBitReader.OnSelectedSensorChanged -= Update;
        MicroBitReader.OnMeasureChanged -= OnMeasureChanged;
        _botResetCts?.Cancel();
    }

    private async Task Measure(string sensor)
    {
        switch (sensor)
        {
            case "sound": _isMeasuringSound = true; break;
            case "light": _isMeasuringLight = true; break;
            case "temp": _isMeasuringTemp = true; break;
            case "shake": _isMeasuringShake = true; break;
        }

        await InvokeAsync(StateHasChanged);

        await Task.Delay(7000); // 5-second window

        switch (sensor)
        {
            case "sound":
                _lockedSound = MicroBitReader.SoundLevel;
                _isMeasuringSound = false;
                break;
            case "light":
                _lockedLight = MicroBitReader.LightLevel;
                _isMeasuringLight = false;
                break;
            case "temp":
                _lockedTemp = MicroBitReader.TemperatureLevel;
                _isMeasuringTemp = false;
                break;
            case "shake":
                _lockedShake = MicroBitReader.ShakeLevel;
                _isMeasuringShake = false;
                break;
        }

        await UpdateBotText(sensor, sensor switch
        {
            "sound" => _lockedSound!.Value,
            "light" => _lockedLight!.Value,
            "temp" => _lockedTemp!.Value,
            "shake" => _lockedShake!.Value,
            _ => 0f
        });
        await Evaluate();
        await InvokeAsync(StateHasChanged);
    }

    private async Task Evaluate()
    {
        var readings = new List<SensorReading>();
        if (_lockedSound.HasValue) readings.Add(new(c => c.VolumeValue, _lockedSound.Value, 0.25f));
        if (_lockedLight.HasValue) readings.Add(new(c => c.LightValue, _lockedLight.Value, 0.25f));
        if (_lockedTemp.HasValue) readings.Add(new(c => c.TemperatureValue, _lockedTemp.Value, 0.25f));
        if (_lockedShake.HasValue) readings.Add(new(c => c.MovementValue, _lockedShake.Value, 0.25f));

        _candidates = readings.Any()
            ? _dreamGuesser!.Evaluate(readings).ToList()
            : _dreams;

        if (_candidates.Count == 1 && !_dialogOpen)
        {
            await TriggerPossiblyCorrect();
            _dialogOpen = true;
            var parameters = new DialogParameters<GuessDialog> { { x => x.Dream, _candidates[0] } };
            var result = await DialogService.ShowAsync<GuessDialog>("", parameters);
            var dialogResult = await result.Result;

            if (!dialogResult!.Canceled)
                await ConfirmGuess();

            _dialogOpen = false;
            await InvokeAsync(StateHasChanged);
        }
        else
        {
            // Notification sound
            await TriggerNotification();
        }
    }

    private async Task UpdateBotText(string sensor, float value)
    {
        // Cancel any pending reset
        _botResetCts?.Cancel();
        _botResetCts = new CancellationTokenSource();

        _dataBotText = (sensor, value > 0.5f) switch
        {
            ("sound", true) => "Hovsa, det larmer! 🔊",
            ("sound", false) => "Stille og roligt... næsten uhyggeligt! 🤫",
            ("light", true) => "Wow, der er lyst i drømmen! ☀️",
            ("light", false) => "Det er godt nok mørkt hva? 🌑",
            ("temp", true) => "Puh, det er varmt her! 🥵",
            ("temp", false) => "Brr, det er koldt! 🥶",
            ("shake", true) => "Hold fast, det rokker! 🫨",
            ("shake", false) => "Rolig som en sø! 🧘",
            _ => _dataBotText
        };
        _bubbleColor = "#1976d2";
        _bubbleTextColor = "#ffffff";

        await InvokeAsync(StateHasChanged);

        try
        {
            await Task.Delay(6000, _botResetCts.Token);
            _bubbleColor = "#e0e0e0";
            _bubbleTextColor = "#212121";
            _dataBotText = "Jeg venter på din næste måling!";
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException)
        {
        }
    }

    private async Task PlaySoundAsync(string elementId)
    {
        await JsRuntime.InvokeVoidAsync("eval", $"document.getElementById('{elementId}').play()");
    }

    private async Task TriggerPossiblyCorrect()
    {
        await PlaySoundAsync("possiblyCorrect");
    }

    private async Task TriggerNotification()
    {
        await PlaySoundAsync("notificationSound");
    }

    private async Task TriggerTada()
    {
        await PlaySoundAsync("tada");
    }

    private void OverlayOnClosed()
    {
        _confirmedDream = null;
        _hiddenHintBlocks = [0, 1, 2, 3];
        _hiddenSensorBlocks = [0, 1, 2, 3];
    }

}