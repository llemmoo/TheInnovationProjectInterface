@page "/"
@using TheInterface.Components.Dialogs
@using TheInterface.Core
@using TheInterface.Model
@inject MicroBitReader MicroBitReader
@inject IDialogService DialogService
@implements IDisposable

<PageTitle>HJÆLP DATABOTTEN MED AT FINDE HITO</PageTitle>

<MudGrid Style="margin-top: 3vh;">
    <MudItem xs="8">
        <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge">
            <MudPaper Class="d-flex align-center justify-center mud-width-full py-8">
                <MudGrid Class="mt-4">
                    <MudItem xs=12 Style="justify-self:center; align-self: center; margin: 0.5vw">
                        <MudCard Style="align-items: center; justify-items: center;">
                            <MudText Typo="Typo.h1">🤖</MudText>
                            <MudText Typo="Typo.h5">@_dataBotText</MudText>
                        </MudCard>
                    </MudItem>
                    @foreach (var card in _caseCards)
                    {
                        var isViable = _candidates.Contains(card);
                        <MudItem xs="3" Style="margin: 0vw">
                            <MudCard Style="@(isViable ? "" : "opacity: 0.4; filter: grayscale(100%); transition: all 0.3s ease;")">
                                <MudImage Style="width: 100%" Width="500" Height="150" ObjectFit="ObjectFit.Contain"
                                          Src="@card.PhotoUrl"/>
                                <MudCardContent>
                                    <MudText>@card.Name</MudText>
                                    @if (!isViable)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Close" Color="Color.Error"/>
                                    }
                                    else
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success"/>
                                    }
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    }
                </MudGrid>
            </MudPaper>
        </MudContainer>
    </MudItem>

    <MudItem xs="3">
        <MudPaper Class="d-flex align-center justify-center mud-width-full mx-8" Elevation="4">
            <MudStack Style="width:100%; padding:16px;">
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" FullWidth="true"
                           OnClick="ResetAll">
                    Nulstil målinger
                </MudButton>
                @if (_lockedSound.HasValue)
                {
                    <MudStack Row="true">
                        <MudChip T="string" Color="Color.Primary" Size="Size.Small">
                            🔊 Målt: @(_lockedSound.Value.ToString("F2"))
                        </MudChip>
                        <MudButton Variant="Variant.Filled" Size="Size.Small" OnClick="@(() => Reset(Sensor.Sound))">Nulstil</MudButton>
                    </MudStack>
                }
                @if (_lockedLight.HasValue)
                {
                    <MudStack Row="true">
                        <MudChip T="string" Color="Color.Warning" Size="Size.Small">
                            💡 Målt: @(_lockedLight.Value.ToString("F2"))
                        </MudChip>
                        <MudButton Variant="Variant.Filled" Size="Size.Small" OnClick="@(() => Reset(Sensor.Light))">Nulstil</MudButton>
                    </MudStack>
                }
                @if (_lockedTemp.HasValue)
                {
                    <MudStack Row="true">
                        <MudChip T="string" Color="Color.Error" Size="Size.Small">
                            🌡️ Målt: @(_lockedTemp.Value.ToString("F2"))
                        </MudChip>
                        <MudButton Variant="Variant.Filled" Size="Size.Small" OnClick="@(() => Reset(Sensor.Temperature))">Nulstil</MudButton>
                    </MudStack>
                }
                @if (_lockedShake.HasValue)
                {
                    <MudStack Row="true" Justify="Justify.Center">
                        <MudChip T="string" Color="Color.Success" Size="Size.Small">
                            🫨 Målt: @(_lockedShake.Value.ToString("F2"))
                        </MudChip>
                        <MudButton Variant="Variant.Filled" Size="Size.Small" OnClick="@(() => Reset(Sensor.Shake))">Nulstil</MudButton>
                    </MudStack>
                }
                
                @switch (MicroBitReader.SelectedSensor)
                {
                    case Sensor.Sound:
                        <MudStack>
                            <MudText Typo="Typo.caption">
                                Lyd @(_isMeasuringSound ? " — måler..." : "")
                            </MudText>
                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@Icons.Material.Filled.VolumeOff"/>
                                <MudSlider
                                    Value="@(_isMeasuringSound ? MicroBitReader.SoundLevel : (_lockedSound ?? MicroBitReader.SoundLevel))"
                                    Min="0.0" Max="1.0" Step="0.01" Disabled="true"
                                    Color="Color.Primary" Style="flex:1;"/>
                                <MudIcon Icon="@Icons.Material.Filled.VolumeUp"/>
                            </MudStack>
                        </MudStack>
                        break;

                    case Sensor.Light:
                        <MudStack>
                            <MudText Typo="Typo.caption">
                                Lys @(_isMeasuringLight ? " — måler..." : "")
                            </MudText>
                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@Icons.Material.Filled.DarkMode"/>
                                <MudSlider
                                    Value="@(_isMeasuringLight ? MicroBitReader.LightLevel : (_lockedLight ?? MicroBitReader.LightLevel))"
                                    Min="0.0" Max="1.0" Step="0.01" Disabled="true"
                                    Color="Color.Warning" Style="flex:1;"/>
                                <MudIcon Icon="@Icons.Material.Filled.LightMode"/>
                            </MudStack>
                        </MudStack>
                        break;

                    case Sensor.Temperature:
                        <MudStack>
                            <MudText Typo="Typo.caption">
                                Temperatur @(_isMeasuringTemp ? " — måler..." : "")
                            </MudText>
                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@Icons.Material.Filled.AcUnit"/>
                                <MudSlider
                                    Value="@(_isMeasuringTemp ? MicroBitReader.TemperatureLevel : (_lockedTemp ?? MicroBitReader.TemperatureLevel))"
                                    Min="0.0" Max="1.0" Step="0.01" Disabled="true"
                                    Color="Color.Error" Style="flex:1;"/>
                                <MudIcon Icon="@Icons.Material.Filled.Whatshot"/>
                            </MudStack>
                        </MudStack>
                        break;

                    case Sensor.Shake:
                        <MudStack>
                            <MudText Typo="Typo.caption">
                                Bevægelse @(_isMeasuringShake ? " — måler..." : "")
                            </MudText>
                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@Icons.Material.Filled.SelfImprovement"/>
                                <MudSlider
                                    Value="@(_isMeasuringShake ? MicroBitReader.ShakeLevel : (_lockedShake ?? MicroBitReader.ShakeLevel))"
                                    Min="0.0" Max="1.0" Step="0.01" Disabled="true"
                                    Color="Color.Success" Style="flex:1;"/>
                                <MudIcon Icon="@Icons.Material.Filled.DirectionsRun"/>
                            </MudStack>
                        </MudStack>
                        break;
                }
            </MudStack>
        </MudPaper>
    </MudItem>
</MudGrid>

<ConfettiOverlay Visible="_showConfetti"/>

@if (_confirmedCard is not null)
{
    <MudOverlay Visible="true" DarkBackground="true" @onclick="() => _confirmedCard = null">
        <MudStack AlignItems="AlignItems.Center">
            <MudImage Src="@_confirmedCard.PhotoUrl" Width="1000" Height="600" ObjectFit="ObjectFit.Contain"/>
            <MudText Typo="Typo.h3" Style="color:white;">@_confirmedCard.Name</MudText>
            <MudText Style="color:white;">Sådan! Vi fandt Hito!</MudText>
        </MudStack>
    </MudOverlay>
}

@code {
    private bool _isMeasuringSound, _isMeasuringLight, _isMeasuringTemp, _isMeasuringShake;
    private bool _dialogOpen;
    private float? _lockedSound, _lockedLight, _lockedTemp, _lockedShake;
    private CancellationTokenSource? _botResetCts;
    private string _dataBotText;
    private CaseGuesser? _caseGuesser;
    private List<CaseCard> _candidates = [];
    private bool _showGuessDialog;
    private CaseCard? _confirmedCard;
    private bool _showConfetti;

    private List<CaseCard> _caseCards =
    [
        new() { Name = "Månen",       LightValue = 0.25f, VolumeValue = 0.25f, MovementValue = 0.25f, TemperatureValue = 0.25f, PhotoUrl = "./Images/CaseCards/Moon.png" },
        new() { Name = "I Pyramiden", LightValue = 0.25f, VolumeValue = 0.25f, MovementValue = 0.25f, TemperatureValue = 0.75f, PhotoUrl = "./Images/CaseCards/Pyramids.png" },
        new() { Name = "Nordpolen",   LightValue = 0.75f, VolumeValue = 0.25f, MovementValue = 0.25f, TemperatureValue = 0.25f, PhotoUrl = "./Images/CaseCards/NorthPole.png" },
        new() { Name = "Safari",      LightValue = 0.75f, VolumeValue = 0.25f, MovementValue = 0.25f, TemperatureValue = 0.75f, PhotoUrl = "./Images/CaseCards/Safari.png" },
        new() { Name = "På bunden",   LightValue = 0.25f, VolumeValue = 0.75f, MovementValue = 0.75f, TemperatureValue = 0.25f, PhotoUrl = "./Images/CaseCards/BottomOcean.png" },
        new() { Name = "Drage",       LightValue = 0.25f, VolumeValue = 0.75f, MovementValue = 0.75f, TemperatureValue = 0.75f, PhotoUrl = "./Images/CaseCards/Dragon.png" },
        new() { Name = "Pirat",       LightValue = 0.75f, VolumeValue = 0.75f, MovementValue = 0.75f, TemperatureValue = 0.25f, PhotoUrl = "./Images/CaseCards/Pirate.png" },
        new() { Name = "Tivoli",      LightValue = 0.75f, VolumeValue = 0.75f, MovementValue = 0.75f, TemperatureValue = 0.75f, PhotoUrl = "./Images/CaseCards/Tivoli.png" },
    ];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await DialogService.ShowAsync<IntroDialog>("", new DialogOptions
            {
                MaxWidth = MaxWidth.Small,
                FullWidth = true,
                CloseOnEscapeKey = false,
                BackdropClick = false
            });
        }
    }

    protected override void OnInitialized()
    {
        _caseGuesser = new CaseGuesser(_caseCards);
        _candidates = _caseCards;
        MicroBitReader.OnSoundLevelChanged += Update;
        MicroBitReader.OnLightLevelChanged += Update;
        MicroBitReader.OnTemperatureLevelChanged += Update;
        MicroBitReader.OnShakeLevelChanged += Update;
        MicroBitReader.OnSelectedSensorChanged += Update;
        MicroBitReader.OnMeasureChanged += OnMeasureChanged;
        _dataBotText = "Jeg venter på din næste måling!";
    }

    // Called every time measure changes value on the micro:bit.
    // Only act on the rising edge (measure == true) and only when not already measuring that sensor.
    private void OnMeasureChanged()
    {
        if (!MicroBitReader.Measure) return;

        var alreadyMeasuring = MicroBitReader.SelectedSensor switch
        {
            Sensor.Sound       => _isMeasuringSound,
            Sensor.Light       => _isMeasuringLight,
            Sensor.Temperature => _isMeasuringTemp,
            Sensor.Shake       => _isMeasuringShake,
            _                  => false
        };

        if (alreadyMeasuring) return;

        var sensorKey = MicroBitReader.SelectedSensor switch
        {
            Sensor.Sound       => "sound",
            Sensor.Light       => "light",
            Sensor.Temperature => "temp",
            Sensor.Shake       => "shake",
            _                  => null
        };

        if (sensorKey is null) return;

        // Fire-and-forget onto the UI thread
        InvokeAsync(() => Measure(sensorKey));
    }

    private void ResetAll()
    {
        _lockedSound = _lockedLight = _lockedTemp = _lockedShake = null;
        _isMeasuringSound = _isMeasuringLight = _isMeasuringTemp = _isMeasuringShake = false;
        _candidates = _caseCards;
        _confirmedCard = null;
        _showGuessDialog = false;
    }    
    
    private async Task Reset(Sensor sensorToReset)
    {
        switch (sensorToReset)
        {
            case Sensor.Sound:
                _lockedSound = null;
                break;
            case Sensor.Light:
                _lockedLight = null;
                break; 
            case Sensor.Temperature:
                _lockedTemp = null;
                break;
            case Sensor.Shake:
                _lockedShake = null;
                break;
        }
        
        await Evaluate();

    }

    private async Task ConfirmGuess()
    {
        _confirmedCard = _candidates[0];
        _showGuessDialog = false;
        _showConfetti = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(3500);
        _showConfetti = false;
        await InvokeAsync(StateHasChanged);
    }

    private void Update() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        MicroBitReader.OnSoundLevelChanged -= Update;
        MicroBitReader.OnLightLevelChanged -= Update;
        MicroBitReader.OnTemperatureLevelChanged -= Update;
        MicroBitReader.OnShakeLevelChanged -= Update;
        MicroBitReader.OnSelectedSensorChanged -= Update;
        MicroBitReader.OnMeasureChanged -= OnMeasureChanged;
        _botResetCts?.Cancel();
    }

    private async Task Measure(string sensor)
    {
        switch (sensor)
        {
            case "sound": _isMeasuringSound = true; break;
            case "light": _isMeasuringLight = true; break;
            case "temp":  _isMeasuringTemp  = true; break;
            case "shake": _isMeasuringShake = true; break;
        }
        await InvokeAsync(StateHasChanged);

        await Task.Delay(7000); // 5-second window

        switch (sensor)
        {
            case "sound":
                _lockedSound = MicroBitReader.SoundLevel;
                _isMeasuringSound = false;
                break;
            case "light":
                _lockedLight = MicroBitReader.LightLevel;
                _isMeasuringLight = false;
                break;
            case "temp":
                _lockedTemp = MicroBitReader.TemperatureLevel;
                _isMeasuringTemp = false;
                break;
            case "shake":
                _lockedShake = MicroBitReader.ShakeLevel;
                _isMeasuringShake = false;
                break;
        }
        await UpdateBotText(sensor, sensor switch          // ← add this
        {
            "sound" => _lockedSound!.Value,
            "light" => _lockedLight!.Value,
            "temp"  => _lockedTemp!.Value,
            "shake" => _lockedShake!.Value,
            _       => 0f
        });
        await Evaluate();
        await InvokeAsync(StateHasChanged);
    }

    private async Task Evaluate()
    {
        var readings = new List<SensorReading>();
        if (_lockedSound.HasValue) readings.Add(new(c => c.VolumeValue,      _lockedSound.Value, 0.25f));
        if (_lockedLight.HasValue) readings.Add(new(c => c.LightValue,       _lockedLight.Value, 0.25f));
        if (_lockedTemp.HasValue)  readings.Add(new(c => c.TemperatureValue, _lockedTemp.Value,  0.25f));
        if (_lockedShake.HasValue) readings.Add(new(c => c.MovementValue,    _lockedShake.Value, 0.25f));

        _candidates = readings.Any()
            ? _caseGuesser!.Evaluate(readings).ToList()
            : _caseCards;

        if (_candidates.Count == 1 && !_dialogOpen)
        {
            _dialogOpen = true;
            var parameters = new DialogParameters<GuessDialog> { { x => x.Card, _candidates[0] } };
            var result = await DialogService.ShowAsync<GuessDialog>("", parameters);
            var dialogResult = await result.Result;

            if (!dialogResult.Canceled)
                await ConfirmGuess();

            _dialogOpen = false;
            await InvokeAsync(StateHasChanged);
        }
    }
    
    private async Task UpdateBotText(string sensor, float value)
    {
        // Cancel any pending reset
        _botResetCts?.Cancel();
        _botResetCts = new CancellationTokenSource();

        _dataBotText = (sensor, value > 0.5f) switch
        {
            ("sound", true)  => "Hovsa, det larmer! 🔊",
            ("sound", false) => "Stille og roligt... næsten uhyggeligt! 🤫",
            ("light", true)  => "Wow, der er lyst i drømmen! ☀️",
            ("light", false) => "Det er godt nok mørkt hva? 🌑",
            ("temp",  true)  => "Puh, det er varmt her! 🥵",
            ("temp",  false) => "Brr, det er koldt! 🥶",
            ("shake", true)  => "Hold fast, det rokker! 🫨",
            ("shake", false) => "Rolig som en sø! 🧘",
            _                => _dataBotText
        };

        await InvokeAsync(StateHasChanged);

        try
        {
            await Task.Delay(2500, _botResetCts.Token);
            _dataBotText = "Jeg venter på din næste måling!";
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException) { }
    }
}