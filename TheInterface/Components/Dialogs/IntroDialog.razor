<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h4" Align="Align.Center">Hjælp mig med at finde Hito! 🤖</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudImage Src="@_imageUrls![_instructionCounter]" ObjectFit="ObjectFit.Fill"/>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudStack Style="width:100%">
            <MudStack Style="width:100%" Row="true" Justify="Justify.SpaceBetween">
                <MudButton Size="Size.Large" Variant="Variant.Filled" Color="Color.Primary" FullWidth="false" Disabled="@(_instructionCounter == 0)"
                           OnClick="@(() => _instructionCounter--)">
                    Forrige
                </MudButton>
                <MudButton Size="Size.Large" Variant="Variant.Filled" Color="Color.Primary" FullWidth="false" Disabled="@(_instructionCounter == 4)"
                           OnClick="@(() => _instructionCounter++)">
                    Næste
                </MudButton>
            </MudStack>
            @if (_instructionCounter == 4)
            {
                <MudButton Size="Size.Large" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                           OnClick="() => MudDialog.Close()">
                    Lad os hjælpe Hito!
                </MudButton>
            }
        </MudStack>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    private int _instructionCounter;
    private List<string>? _imageUrls;

    protected override void OnInitialized()
    {
        _imageUrls = [
            "./Images/Instructions/hito_instruction1.png", 
            "./Images/Instructions/hito_instruction2.png",
            "./Images/Instructions/hito_instruction3.png",
            "./Images/Instructions/hito_instruction4.png",
            "./Images/Instructions/hito_instruction5.png",
            ];
    }
}